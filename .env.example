[TEMPLATE]
# Copy to .env and fill in. Never commit .env — see CLAUDE.md Section 13.
#
# The backend's config.py (Phase 1A) implements this exact contract. Legacy variables
# (GEMINI_API_KEY, GROQ_API_KEY, REDIS_URL, LLM_PROVIDER_ORDER, ...) are no longer
# required: they are still accepted for compatibility while their legacy modules are
# being replaced, but a Section 13 environment must not need them.

# --- Database (Supabase / Postgres — the only datastore) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth — JWT secret (still required until Phase 2 re-scopes JWT verification) ---
# app/security/auth.py verifies Supabase HS256 session tokens with this shared secret.
# It is a security control, not optional, while that layer exists; Phase 2 moves auth
# to Supabase-issued asymmetric tokens only and this variable goes away.
JWT_SECRET=

# --- LLM — one provider, configured, never hardcoded ---
# CLAUDE.md Section 2: ONE model, configured entirely through environment
# variables. Must run against free-tier or free-routed models. No fallback chain.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Optional: provider-specific base URL. Leave empty to use the provider's default.
LLM_BASE_URL=

# --- Embeddings — local, free, pinned ---
# Exactly ONE local model via sentence-transformers. Never mix models in one
# index; changing the model requires re-embedding everything.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- Reranker — local, free ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
# Pre-rerank candidate pool must be >= post-rerank final count (validated at boot).
RETRIEVAL_CANDIDATE_COUNT=15
RETRIEVAL_FINAL_COUNT=8
RETRIEVAL_RELEVANCE_THRESHOLD=0.3

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- CORS (production; comma-separated list of allowed origins) ---
# In development, defaults to http://localhost:3000.
# For deployment, set to your frontend URL(s), e.g.:
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app
#   CORS_ALLOW_ORIGINS=https://app1.vercel.app,https://app2.vercel.app
CORS_ALLOW_ORIGINS=

# --- Frontend (build-time; required by the Next.js app) ---
# NEXT_PUBLIC_ vars are inlined into the client bundle and visible to anyone,
# so only ever put non-secret values here. The anon/publishable Supabase key is
# designed to be public.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
