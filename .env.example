# Copy to .env and fill in. Never commit .env — see CLAUDE.md Section 13.

# --- Database (Supabase / Postgres — the only datastore) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM — sequential fallback chain, never parallel ---
# Primary provider:
GROQ_API_KEY=
#
# Fallback provider:
OPENROUTER_API_KEY=
#
# Secondary fallback provider:
GEMINI_API_KEY=
#
# Optional overrides — only needed if you want a non-default model or base URL
# for the primary provider.
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=
# Ceiling on the max_tokens field sent to any provider; defaults to 8000 (safely
# under a 16k model's limit, above the default 4096 answer budget). Raise it only
# if a provider/model with a larger output cap needs long generations.
# LLM_MAX_OUTPUT_TOKENS_CAP=8000

# --- Embeddings — hosted Voyage voyage-4-lite (1024-dim), no local ML ---
# Replaces the local torch/sentence-transformers stack (render worker must never
# import torch — idle memory stays inside the free tier). Uses the official
# voyageai SDK; corpus and query task types (input_type=document/query) are set
# automatically and EMBEDDING_DIMENSION is pinned via output_dimension on every
# request. EMBEDDING_API_KEY is an optional generic override; VOYAGE_API_KEY is
# the primary key for this provider.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSION=1024
VOYAGE_API_KEY=
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_SECONDS=30

# --- Retrieval tuning ---
# Pre-score candidate pool must be >= final count (validated at boot).
RETRIEVAL_CANDIDATE_COUNT=15
RETRIEVAL_FINAL_COUNT=8
# Cosine-similarity thresholds (range [0,1]); 0.30 is "clearly relevant", 0.25
# "on-topic enough". Start value for a 1024-dim voyage-4-lite index; see the
# eval docstring in eval/runner.py before changing.
RETRIEVAL_RELEVANCE_THRESHOLD=0.30

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Demo ---
# Optional: point the demo flow at an existing workspace instead of provisioning a new one.
# When set, seed_demo_workspace() looks up this workspace by ID (must exist) and skips
# owner creation / workspace provisioning entirely.
DEMO_WORKSPACE_ID=

# --- CORS (production; comma-separated list of allowed origins) ---
# In development, defaults to http://localhost:3000.
# For deployment, set to your frontend URL(s), e.g.:
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app
#   CORS_ALLOW_ORIGINS=https://app1.vercel.app,https://app2.vercel.app
CORS_ALLOW_ORIGINS=

# --- Optional: additional providers / hooks ---------------------------------
# NVIDIA is a fourth provider in the fallback chain (rotating tier).
# NVIDIA_API_KEY=
# HS256 fallback for legacy Supabase projects and locally minted test tokens;
# modern Supabase verifies ES256 via JWKS and does not need this.
# JWT_SECRET=
# Sentry observability (all optional; errors are logged regardless).
# SENTRY_DSN=
# SENTRY_RELEASE=

# --- Frontend (build-time; required by the Next.js app) ---
# NEXT_PUBLIC_ vars are inlined into the client bundle and visible to anyone,
# so only ever put non-secret values here. The anon/publishable Supabase key is
# designed to be public.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
