# Copy to .env and fill in. Never commit .env — see CLAUDE.md 4.1

# Database
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Tests only: a throwaway Postgres with migrations applied. The RLS security suite
# skips without it, so leaving it empty means those tests never actually run.
TEST_DATABASE_URL=

# LLMs
GEMINI_API_KEY=
GROQ_API_KEY=
# Failover order, tried left to right. Groq leads by default; Gemini is the automatic
# fallback when Groq is unavailable or rate limited. Known names: groq, gemini.
LLM_PROVIDER_ORDER=groq,gemini
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_GEMINI_MODEL=gemini-2.0-flash

# Redis / Celery
REDIS_URL=

# Auth
JWT_SECRET=

# Observability
SENTRY_DSN=
LANGSMITH_API_KEY=

# GitHub MCP
GITHUB_TOKEN=

# Frontend — where the browser reaches the backend. NEXT_PUBLIC_ vars are inlined into
# the client bundle and visible to anyone, so only ever put non-secret values here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase Auth, used by the browser to sign in and hold a session. The anon/publishable
# key is designed to be public — it grants nothing on its own, because RLS decides what a
# session may read. Never put the service-role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
